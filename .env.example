# san_sw 환경변수 예시 — 실제 사용 시 `.env`로 복사 후 수정하세요.
#   cp .env.example .env
# systemd: EnvironmentFile=/opt/san_sw/.env
# docker-compose: env_file 로 참조(또는 environment 직접 기입)

# --- 네트워크/실행 ---
# uvicorn 직접 실행(run.sh) 시 사용. systemd/compose는 별도 지정.
SANSW_HOST=0.0.0.0
SANSW_PORT=8000

# --- 데이터/저장 ---
# SQLite 및 secret.key 저장 위치
SANSW_DATA_DIR=/opt/san_sw/data
# SANSW_DB_PATH=/opt/san_sw/data/sansw.db

# --- 폴링 ---
SANSW_POLL_INTERVAL=60          # 초. 0 이하면 백그라운드 폴러 끔
SANSW_HTTP_TIMEOUT=15

# --- 데모 ---
SANSW_SEED_DEMO=0               # 운영은 0 권장(데모 스위치 미생성)

# --- 보안: 비밀번호 암호화 키(필수 권장) ---
# 길고 무작위한 문자열. 미설정 시 data/secret.key 자동생성.
# SANSW_SECRET_KEY=change-this-to-a-long-random-secret

# --- 인증/RBAC ---
SANSW_AUTH_ENABLED=0            # 1이면 로그인 필수(변경/관리 endpoint 보호)
SANSW_ADMIN_USER=admin
SANSW_ADMIN_PASS=change-me      # 최초 1회 부트스트랩에만 사용
SANSW_SESSION_TTL=28800         # 세션 토큰 만료(초)

# --- 알림 ---
SANSW_ALERT_EVAL_ON_POLL=1
# SANSW_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXXX

# --- 자동 업그레이드 ---
SANSW_GITHUB_REPO=noainred/san_sw
SANSW_ALLOW_UPGRADE_APPLY=0     # 1이면 /api/upgrade/apply 허용

# --- SNMP 기본값(스위치별 미지정 시) ---
SANSW_SNMP_COMMUNITY=public
SANSW_SNMP_PORT=161

# --- 외부 시크릿(Vault, 선택) ---
SANSW_SECRET_BACKEND=local      # local | vault
# SANSW_VAULT_ADDR=https://vault.example.com:8200
# SANSW_VAULT_TOKEN=s.xxxxx
# SANSW_VAULT_KV_PATH=secret/data/san_sw
